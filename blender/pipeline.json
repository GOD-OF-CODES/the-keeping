{
  "version": 1,
  "blender": "/Applications/Blender.app/Contents/MacOS/Blender",
  "libInputs": ["blender/lib/*.py"],
  "sharedAssetDirs": ["public/assets/voice"],
  "budgetsMB": { "low": 27, "medium": 60, "max": 120 },
  "jobs": [
    {
      "id": "smoke-s1",
      "group": "smoke",
      "description": "S1 GLB export: UV2, extras, 2 NLA clips, shape key, meshopt; parsed by three r186 in Node",
      "script": "blender/tests/smoke_s1.py",
      "inputs": ["blender/tests/check_glb.mjs"],
      "outputs": [{ "path": ".cache/smoke/s1/result.json" }, { "path": ".cache/smoke/s1/s1_meshopt.glb" }],
      "post": [["node", "blender/tests/check_glb.mjs", ".cache/smoke/s1"]]
    },
    {
      "id": "smoke-s3",
      "group": "smoke",
      "description": "S3 photometric calibration: DIFFUSE bake vs analytic point-light irradiance",
      "script": "blender/tests/smoke_s3.py",
      "outputs": [{ "path": ".cache/smoke/s3/result.json" }]
    },
    {
      "id": "smoke-s4-1024-64",
      "group": "smoke",
      "description": "S4 bake budget: 5x6x3 m room, 1024^2 @ 64 spp Metal + OIDN",
      "script": "blender/tests/smoke_s4.py",
      "args": ["--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "outputs": [{ "path": ".cache/smoke/s4/room_1024_64.json" }, { "path": ".cache/smoke/s4/room_1024_64.npz" }]
    },
    {
      "id": "smoke-s4-1024-128",
      "group": "smoke",
      "description": "S4 bake budget: 1024^2 @ 128 spp Metal + OIDN",
      "script": "blender/tests/smoke_s4.py",
      "args": ["--size", "1024", "--samples", "128"],
      "cyclesLog": true,
      "outputs": [{ "path": ".cache/smoke/s4/room_1024_128.json" }, { "path": ".cache/smoke/s4/room_1024_128.npz" }]
    },
    {
      "id": "smoke-s4-2048-32",
      "group": "smoke",
      "manual": true,
      "description": "S4 optional 2048^2 @ 32 spp (only with plenty of free RAM, no browser open)",
      "script": "blender/tests/smoke_s4.py",
      "args": ["--size", "2048", "--samples", "32", "--min-avail-gb", "2.5"],
      "cyclesLog": true,
      "outputs": [{ "path": ".cache/smoke/s4/room_2048_32.json" }]
    },
    {
      "id": "smoke-s2",
      "group": "smoke",
      "description": "S2 lightmap container: F-pattern orientation, EXR codecs x RGB/RGBA, f16gz fallback, real atlas sizes",
      "script": "blender/tests/smoke_s2.py",
      "inputs": [".cache/smoke/s4/*.npz", "blender/tests/check_exr.mjs"],
      "outputs": [{ "path": ".cache/smoke/s2/result.json" }],
      "post": [["node", "blender/tests/check_exr.mjs", ".cache/smoke/s2"]]
    },
    {
      "id": "house",
      "group": "content",
      "description": "House shell from src/shared/level-layout.json -> public/assets/<tier>/house_<atlas>.glb + details_<atlas>.glb + doors.glb + collision.glb, .cache/house/house.blend (docs/HOUSE.md)",
      "script": "blender/house/build_house.py",
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/house/__init__.py",
                 "blender/house/geom.py", "blender/house/plan.py", "blender/house/rooms.py", "blender/house/stairs.py",
                 "blender/house/trim.py", "blender/house/openings.py", "blender/house/windows.py",
                 "blender/house/doors.py", "blender/house/exterior.py", "blender/house/deform.py",
                 "blender/house/collision.py", "blender/house/lmuv.py", "blender/house/terrain.py",
                 "blender/house/groundcover.py", "blender/house/treeline.py", "blender/props/trees.py",
                 "blender/props/bells_rope.py", "blender/props/kit.py", "blender/props/registry.py"],
      "outputs": [
        { "path": ".cache/house/house.blend" },
        { "path": ".cache/house/build.json" },
        { "path": "public/assets/max/house_ground.glb", "expect": { "lightmapped": true } },
        { "path": "public/assets/max/house_parlor.glb", "expect": { "lightmapped": true } },
        { "path": "public/assets/max/house_kitchen.glb", "expect": { "lightmapped": true } },
        { "path": "public/assets/max/house_upper_hall.glb", "expect": { "lightmapped": true } },
        { "path": "public/assets/max/house_upper_rooms.glb", "expect": { "lightmapped": true } },
        { "path": "public/assets/max/house_exterior.glb", "expect": { "lightmapped": true } },
        { "path": "public/assets/max/doors.glb" },
        { "path": "public/assets/max/collision.glb" }
      ],
      "post": [["node", "blender/house/check_house.mjs"]]
    },
    {
      "id": "props",
      "group": "content",
      "description": "Prop generators (blender/props, facing -y at yaw 0) -> public/assets/<tier>/props_m1.glb + props_m2.glb (Low: decimated LOD), static props UV2 in their room atlas band, .cache/props/props.blend for the bakes, review renders scratch/props/*.png + docs/props-contact.png",
      "script": "blender/props/build_props.py",
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/props/**", "blender/house/lmuv.py"],
      "outputs": [
        { "path": "public/assets/low/props_m1.glb" },
        { "path": "public/assets/medium/props_m1.glb" },
        { "path": "public/assets/max/props_m1.glb" },
        { "path": "public/assets/low/props_m2.glb" },
        { "path": "public/assets/medium/props_m2.glb" },
        { "path": "public/assets/max/props_m2.glb" },
        { "path": "public/assets/low/props_road.glb" },
        { "path": "public/assets/medium/props_road.glb" },
        { "path": "public/assets/max/props_road.glb" },
        { "path": ".cache/props/props.json" },
        { "path": ".cache/props/props.blend" },
        { "path": ".cache/props/lightmap.json" },
        { "path": "docs/props-contact.png" }
      ],
      "post": [["node", "blender/props/check_props.mjs"]]
    },
    {
      "id": "bake-house-ground",
      "group": "bake",
      "description": "Dev bake LM_GROUND (1024^2, 64 spp, Metal) + OIDN + per-tier KLM (Low 512^2 m6) -> public/assets/<tier>/lm_ground.klm (house + static props band)",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_GROUND", "--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_ground.npz" }, { "path": "public/assets/max/lm_ground.klm" }]
    },
    {
      "id": "bake-house-parlor",
      "group": "bake",
      "description": "Dev bake LM_PARLOR (1024^2, 64 spp) -> lm_parlor.klm",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_PARLOR", "--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_parlor.npz" }, { "path": "public/assets/max/lm_parlor.klm" }]
    },
    {
      "id": "bake-house-kitchen",
      "group": "bake",
      "description": "Dev bake LM_KITCHEN (1024^2, 64 spp) -> lm_kitchen.klm",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_KITCHEN", "--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_kitchen.npz" }, { "path": "public/assets/max/lm_kitchen.klm" }]
    },
    {
      "id": "bake-house-upper-hall",
      "group": "bake",
      "description": "Dev bake LM_UPPER_HALL (1024^2, 64 spp) + lightning flash map -> lm_upper_hall.klm, lm_upper_hall_flash.klm",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_UPPER_HALL", "--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_upper_hall.npz" }, { "path": "public/assets/max/lm_upper_hall.klm" },
                  { "path": "public/assets/max/lm_upper_hall_flash.klm" }]
    },
    {
      "id": "bake-house-upper-rooms",
      "group": "bake",
      "description": "Dev bake LM_UPPER_ROOMS (1024^2, 64 spp) + lightning flash map -> lm_upper_rooms.klm, lm_upper_rooms_flash.klm",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_UPPER_ROOMS", "--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_upper_rooms.npz" }, { "path": "public/assets/max/lm_upper_rooms.klm" },
                  { "path": "public/assets/max/lm_upper_rooms_flash.klm" }]
    },
    {
      "id": "bake-house-exterior",
      "group": "bake",
      "description": "Dev bake LM_EXTERIOR (1024^2, 64 spp) -> lm_exterior.klm",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_EXTERIOR", "--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_exterior.npz" }, { "path": "public/assets/max/lm_exterior.klm" }]
    },
    {
      "id": "bake-house-car",
      "group": "bake",
      "description": "Dev bake LM_CAR (sedan interior set, 1024^2, 64 spp; maxResolution 1024 -> tiers 1024/1024/256) -> lm_car.klm",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_CAR", "--size", "1024", "--samples", "64"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_car.npz" }, { "path": "public/assets/max/lm_car.klm" }]
    },
    {
      "id": "bake-release-ground",
      "group": "bake-release",
      "manual": true,
      "description": "RELEASE bake LM_GROUND (2048^2, 128 spp) - only with NO browser/WebGPU session open (~2.4 GB per process): npm run assets -- --only bake-release --force",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_GROUND", "--size", "2048", "--samples", "128"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_ground.npz" }, { "path": "public/assets/max/lm_ground.klm" }]
    },
    {
      "id": "bake-release-parlor",
      "group": "bake-release",
      "manual": true,
      "description": "RELEASE bake LM_PARLOR (2048^2, 128 spp) - only with NO browser/WebGPU session open (~2.4 GB per process): npm run assets -- --only bake-release --force",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_PARLOR", "--size", "2048", "--samples", "128"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_parlor.npz" }, { "path": "public/assets/max/lm_parlor.klm" }]
    },
    {
      "id": "bake-release-kitchen",
      "group": "bake-release",
      "manual": true,
      "description": "RELEASE bake LM_KITCHEN (2048^2, 128 spp) - only with NO browser/WebGPU session open (~2.4 GB per process): npm run assets -- --only bake-release --force",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_KITCHEN", "--size", "2048", "--samples", "128"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_kitchen.npz" }, { "path": "public/assets/max/lm_kitchen.klm" }]
    },
    {
      "id": "bake-release-upper-hall",
      "group": "bake-release",
      "manual": true,
      "description": "RELEASE bake LM_UPPER_HALL (2048^2, 128 spp) - only with NO browser/WebGPU session open (~2.4 GB per process): npm run assets -- --only bake-release --force",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_UPPER_HALL", "--size", "2048", "--samples", "128"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_upper_hall.npz" }, { "path": "public/assets/max/lm_upper_hall.klm" }]
    },
    {
      "id": "bake-release-upper-rooms",
      "group": "bake-release",
      "manual": true,
      "description": "RELEASE bake LM_UPPER_ROOMS (2048^2, 128 spp) - only with NO browser/WebGPU session open (~2.4 GB per process): npm run assets -- --only bake-release --force",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_UPPER_ROOMS", "--size", "2048", "--samples", "128"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_upper_rooms.npz" }, { "path": "public/assets/max/lm_upper_rooms.klm" }]
    },
    {
      "id": "bake-release-exterior",
      "group": "bake-release",
      "manual": true,
      "description": "RELEASE bake LM_EXTERIOR (2048^2, 128 spp) - only with NO browser/WebGPU session open (~2.4 GB per process): npm run assets -- --only bake-release --force",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_EXTERIOR", "--size", "2048", "--samples", "128"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_exterior.npz" }, { "path": "public/assets/max/lm_exterior.klm" }]
    },
    {
      "id": "bake-release-car",
      "group": "bake-release",
      "manual": true,
      "description": "RELEASE bake LM_CAR (1024^2, 128 spp) - only with NO browser/WebGPU session open (~2.4 GB per process): npm run assets -- --only bake-release --force",
      "script": "blender/house/bake_house.py",
      "args": ["--atlas", "LM_CAR", "--size", "1024", "--samples", "128"],
      "cyclesLog": true,
      "libInputs": ["blender/lib/bake.py", "blender/lib/oidn.py", "blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": [{ "path": ".cache/bake/lm_car.npz" }, { "path": "public/assets/max/lm_car.klm" }]
    },
    {
      "id": "house-review",
      "group": "review",
      "manual": true,
      "description": "Review renders of the house shell (Cycles, layout lights, AgX) -> scratch/house/*.png",
      "script": "blender/house/render_review.py",
      "args": ["--samples", "48"],
      "libInputs": ["blender/lib/scene.py", "blender/lib/materials.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", "blender/house/scene_prep.py", "blender/house/plan.py"],
      "outputs": []
    },
    {
      "id": "arms-review",
      "group": "review",
      "manual": true,
      "description": "Review renders of the C1 car arm clips (arms_anim.blend in a clay cabin stand-in) -> scratch/blender-realism/arms_car.png",
      "script": "blender/characters/review_arms_car.py",
      "args": ["--samples", "48"],
      "libInputs": ["blender/lib/scene.py"],
      "inputs": [".cache/anims/arms_anim.blend", "blender/anim/clips_arms.py"],
      "outputs": []
    },
    {
      "id": "cap-test",
      "group": "review",
      "manual": true,
      "description": "One-off probe of delaunay_2d_cdt for the A1 cap disc",
      "script": "blender/tests/cap_cdt.py",
      "outputs": []
    },
    {
      "id": "ada-probe",
      "group": "review",
      "manual": true,
      "description": "One-off probe: atlas colour painted on Ada's collar (fix round)",
      "script": "blender/tests/probe_collar.py",
      "inputs": [".cache/characters/ada.blend"],
      "outputs": []
    },
    {
      "id": "c2-review",
      "group": "review",
      "manual": true,
      "description": "A9 C2-ESCAPE review renders (Cycles, real light values: 12 cd lamp, candles; metered like the runtime eye) of the restaged parlor -> scratch/c2e/a9/*.png + meter.json",
      "script": "blender/anim/review_c2.py",
      "args": ["--samples", "64"],
      "libInputs": ["blender/lib/scene.py"],
      "inputs": [".cache/house/house.blend", ".cache/props/props.blend", ".cache/anims/ada_anim.blend", ".cache/anims/harlan_anim.blend"],
      "outputs": []
    },
    {
      "id": "arms-dim-review",
      "group": "review",
      "manual": true,
      "description": "Dim game-like review of the FP arms rest pose (torch hold + gloves; game view and close-ups) -> scratch/blender-realism/arms_dim.png",
      "script": "blender/characters/review_arms_dim.py",
      "args": ["--samples", "64"],
      "libInputs": ["blender/lib/scene.py"],
      "inputs": [".cache/characters/arms.blend"],
      "outputs": []
    },
    {
      "id": "corridor",
      "group": "content",
      "description": "County Road 9 corridor east of the gate (docs/C1-OPENING.md §2, §6.4): road + ditches + paint, chunked instanced pines (3 LODs x 3 variants), snags, understory, canopy blanket, power-line poles (+ wire points marker), delineators -> public/assets/<tier>/details_corridor.glb (EXT_mesh_gpu_instancing; room RC9); scratch/opening/road-rc9.json",
      "script": "blender/house/corridor.py",
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/house/corridor.py", "blender/house/road_rc9.py", "src/shared/road-rc9.json", "blender/house/pines.py", "blender/house/treeline.py", "blender/props/kit.py", "blender/props/registry.py", "blender/props/trees.py", "blender/props/exterior.py"],
      "outputs": [
        { "path": "public/assets/low/details_corridor.glb" },
        { "path": "public/assets/medium/details_corridor.glb" },
        { "path": "public/assets/max/details_corridor.glb" },
        { "path": ".cache/corridor/corridor.json" }
      ]
    },
    {
      "id": "corridor-review",
      "group": "review",
      "manual": true,
      "description": "Review renders of the RC9 corridor (max tier set) under the shot lights: POV low beams, C0 aerial with lightning, S6 walls, edge pines; reads scratch/opening/corridor_review.json -> scratch/opening/corridor_*.png (run with --force)",
      "script": "blender/house/corridor.py",
      "args": ["--review", "1"],
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/house/corridor.py", "blender/house/review_corridor.py", "blender/house/road_rc9.py", "src/shared/road-rc9.json", "blender/house/pines.py", "blender/props/**"],
      "outputs": []
    },
    {
      "id": "road-review",
      "group": "review",
      "manual": true,
      "description": "Review renders of the RC9 set props (billboard, diner, EAT sign, truck, deer, signs) in clay and under moonlight + low beams; reads scratch/opening/road_review.json -> scratch/opening/road/*.png (run with --force)",
      "script": "blender/props/review_road.py",
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/props/**", "blender/house/scene_prep.py"],
      "outputs": []
    },
    {
      "id": "cabin-review",
      "group": "review",
      "manual": true,
      "description": "Review renders of the C1 cabin (sedan_interior v2 inside the exterior sedan on a road between pine walls) under the shot lights: clay/normals, dash glow, dome light; reads scratch/props/cabin_review.json -> scratch/props/cabin/*.png + metrics.json (run with --force)",
      "script": "blender/props/review_cabin.py",
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/props/**", "blender/house/scene_prep.py"],
      "outputs": []
    },
    {
      "id": "props-wear-review",
      "group": "review",
      "manual": true,
      "description": "Prop wear-mask measurement/review build (docs/PROPS-FINISH.md §6): build_props into scratch/props-wear only (never public/assets or .cache/props); --job-args=\"--types a,b [--no-wear] [--export-dir scratch/props-wear/x] [--render]\"",
      "script": "blender/props/build_props.py",
      "args": ["--export-dir", "scratch/props-wear", "--no-lightmap", "--no-render"],
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/props/**"],
      "outputs": []
    },
    {
      "id": "characters",
      "group": "content",
      "description": "Ada / Harlan / FP arms: SDF anatomy meshes, rigs (bone heat), hair cards, gown/sack/clothes, shape keys, unique baked textures (2048 -> 1024 -> 512)",
      "script": "blender/characters/build_characters.py",
      "inputs": ["blender/characters/**", "src/shared/material-spec.json"],
      "libInputs": ["blender/lib/*.py"],
      "outputs": [
        { "path": ".cache/characters/ada.blend" },
        { "path": ".cache/characters/harlan.blend" },
        { "path": ".cache/characters/arms.blend" },
        { "path": "public/assets/low/ada_albedo.webp", "kind": "texture" },
        { "path": "public/assets/low/ada_normal.png", "kind": "texture" },
        { "path": "public/assets/low/harlan_albedo.webp", "kind": "texture" },
        { "path": "public/assets/low/harlan_normal.png", "kind": "texture" },
        { "path": "public/assets/low/arms_albedo.webp", "kind": "texture" },
        { "path": "public/assets/low/arms_normal.png", "kind": "texture" },
        { "path": "public/assets/low/ada_hair_albedo.webp", "kind": "texture" },
        { "path": "public/assets/low/ada_hair_normal.png", "kind": "texture" },
        { "path": "public/assets/medium/ada_albedo.webp", "kind": "texture" },
        { "path": "public/assets/medium/ada_normal.png", "kind": "texture" },
        { "path": "public/assets/medium/harlan_albedo.webp", "kind": "texture" },
        { "path": "public/assets/medium/harlan_normal.png", "kind": "texture" },
        { "path": "public/assets/medium/arms_albedo.webp", "kind": "texture" },
        { "path": "public/assets/medium/arms_normal.png", "kind": "texture" },
        { "path": "public/assets/medium/ada_hair_albedo.webp", "kind": "texture" },
        { "path": "public/assets/medium/ada_hair_normal.png", "kind": "texture" },
        { "path": "public/assets/max/ada_albedo.webp", "kind": "texture" },
        { "path": "public/assets/max/ada_normal.png", "kind": "texture" },
        { "path": "public/assets/max/harlan_albedo.webp", "kind": "texture" },
        { "path": "public/assets/max/harlan_normal.png", "kind": "texture" },
        { "path": "public/assets/max/arms_albedo.webp", "kind": "texture" },
        { "path": "public/assets/max/arms_normal.png", "kind": "texture" },
        { "path": "public/assets/max/ada_hair_albedo.webp", "kind": "texture" },
        { "path": "public/assets/max/ada_hair_normal.png", "kind": "texture" }
      ]
    },
    {
      "id": "anims",
      "group": "content",
      "description": "Clips via the layered Action API (one per NLA track, in place, 30 fps) -> one GLB per character in every tier",
      "script": "blender/anim/build_anims.py",
      "inputs": ["blender/anim/**", "blender/characters/**", ".cache/characters/*.blend"],
      "libInputs": ["blender/lib/*.py"],
      "outputs": [
        { "path": "public/assets/low/ada.glb", "kind": "character" },
        { "path": "public/assets/low/harlan.glb", "kind": "character" },
        { "path": "public/assets/low/arms.glb", "kind": "character" },
        { "path": "public/assets/medium/ada.glb", "kind": "character" },
        { "path": "public/assets/medium/harlan.glb", "kind": "character" },
        { "path": "public/assets/medium/arms.glb", "kind": "character" },
        { "path": "public/assets/max/ada.glb", "kind": "character" },
        { "path": "public/assets/max/harlan.glb", "kind": "character" },
        { "path": "public/assets/max/arms.glb", "kind": "character" }
      ],
      "post": [["node", "blender/characters/check_chars.mjs"]]
    },
    {
      "id": "bake",
      "group": "content",
      "placeholder": true,
      "description": "Lightmap atlases (one atlas per Blender process) -> .cache/bake/*.npz",
      "script": "blender/bake/bake_atlases.py",
      "inputs": ["src/shared/level-layout.json", "src/shared/material-spec.json", "blender/bake/**", "blender/house/**"],
      "outputs": []
    },
    {
      "id": "encode",
      "group": "bake",
      "description": "Per-tier lightmap encode from the cached float atlases (.cache/bake/lm_*.npz) with lib/encode.py TIER_POLICY -> public/assets/<tier>/lm_*.klm + .json; QA: display error after AgX. Never re-bakes: bake jobs do not hash encode.py, this job does",
      "script": "blender/bake/encode_atlases.py",
      "libInputs": ["blender/lib/encode.py", "blender/lib/bake.py", "blender/lib/scene.py"],
      "inputs": [".cache/bake/*.npz", "src/shared/level-layout.json"],
      "outputs": [{ "path": ".cache/bake/encode.json" }]
    }
  ]
}
